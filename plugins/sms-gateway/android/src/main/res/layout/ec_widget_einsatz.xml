<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/einsatz_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/ec_widget_background">
    <TextView android:id="@+id/einsatz_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EINSATZCOCKPIT" android:textColor="#F15A58" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:id="@+id/einsatz_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" />
    <TextView android:id="@+id/einsatz_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#C8D2E8" android:textSize="13sp" android:maxLines="2" />
    <TextView android:id="@+id/einsatz_meldung" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="3" android:visibility="gone" />
    <LinearLayout android:id="@+id/einsatz_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/einsatz_maps_action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:drawableStart="@drawable/ic_ec_widget_map" android:drawablePadding="4dp" android:gravity="center_vertical" android:text="Maps" android:textColor="#FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/einsatz_object_action" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableStart="@drawable/ic_ec_widget_objects" android:drawablePadding="4dp" android:gravity="center_vertical" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/einsatz_fahrt_action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_ec_widget_fahrt" android:drawablePadding="4dp" android:gravity="center_vertical" android:text="Fahrt erfassen" android:textColor="#FFFFFF" android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:id="@+id/einsatz_map" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="10dp" android:scaleType="centerCrop" android:src="@drawable/ic_ec_widget_map" android:contentDescription="Karte zum Einsatzort" />
    <LinearLayout android:id="@+id/gsl_queue_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone" />
</LinearLayout>
