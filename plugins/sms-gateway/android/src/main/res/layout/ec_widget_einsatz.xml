<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/einsatz_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/ec_widget_background">
    <TextView android:id="@+id/einsatz_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EINSATZCOCKPIT" android:textColor="#F15A58" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:id="@+id/einsatz_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" />
    <TextView android:id="@+id/einsatz_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#C8D2E8" android:textSize="13sp" android:maxLines="2" />
    <ImageView android:id="@+id/einsatz_map" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="10dp" android:scaleType="centerCrop" android:src="@drawable/ic_ec_widget_map" android:contentDescription="Karte zum Einsatzort" />
</LinearLayout>
