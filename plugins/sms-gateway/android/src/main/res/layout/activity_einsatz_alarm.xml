<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#B71C1C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/alarm_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EINSATZALARM"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/alarm_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:gravity="center" />

        <Chronometer
            android:id="@+id/alarm_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:format="Seit %s"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/alarm_acknowledge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_marginTop="32dp"
            android:text="Quittieren"
            android:textColor="#B71C1C"
            android:backgroundTint="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/alarm_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_marginTop="16dp"
            android:text="Einsatz öffnen"
            android:textColor="#B71C1C"
            android:backgroundTint="#FFFFFF"
            android:textSize="22sp" />
    </LinearLayout>
</ScrollView>
