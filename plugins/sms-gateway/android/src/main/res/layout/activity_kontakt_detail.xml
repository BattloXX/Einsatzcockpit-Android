<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/kontaktName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?android:attr/textAppearanceLarge" />
        <TextView android:id="@+id/kontaktFullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/kontaktFunction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/kontaktOrganisation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/kontaktEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="?android:attr/textColorLink" />
        <TextView android:id="@+id/kontaktReachability" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/kontaktNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/phoneHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Telefonnummern" android:textAppearance="?android:attr/textAppearanceMedium" />
        <LinearLayout android:id="@+id/phoneContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView android:id="@+id/assignmentHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Objektzuordnungen" android:textAppearance="?android:attr/textAppearanceMedium" />
        <LinearLayout android:id="@+id/assignmentContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
